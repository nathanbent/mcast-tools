[Unit]
Description=mcast %i
Documentation=https://github.com/nathanbent/mcast-tools
Wants=network-online.target
After=network-online.target sound.target

[Service]
# One instance per file in /etc/mcast: `systemctl enable --now mcast@lobby`
# runs mcast with the MCAST_ARGS set in /etc/mcast/lobby.conf.
EnvironmentFile=/etc/mcast/%i.conf
ExecStart=/usr/bin/mcast $MCAST_ARGS
Restart=always
RestartSec=2

# Runs as a throwaway user that may use sound cards and nothing else.
DynamicUser=yes
SupplementaryGroups=audio
# Recordings (--wav) go here: /var/lib/mcast
StateDirectory=mcast
WorkingDirectory=/var/lib/mcast
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Sound cards are the only devices it may open.
DevicePolicy=closed
DeviceAllow=char-alsa rw
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027

[Install]
WantedBy=multi-user.target
