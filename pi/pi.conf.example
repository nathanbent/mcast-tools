# mcast Raspberry Pi build settings. Copy to pi.conf, edit, then run: sudo ./install.sh
# Every setting is optional; anything left out keeps the default shown here.
# Re-running install.sh after a change is safe: each step is idempotent.

# --- Identity --------------------------------------------------------------
# Hostname to set (empty: keep the one Raspberry Pi Imager set).
PI_HOSTNAME=""
# The login account that gets SSH access (empty: whoever ran sudo).
ADMIN_USER=""

# --- mcast -----------------------------------------------------------------
# Install the latest release binary into /usr/local/bin.
INSTALL_MCAST=yes
# Run "mcast serve" (the web GUI/API, paging). Set to "no" on a Pi that is
# only a probe.
MCAST_SERVE=yes
# Address the web GUI/API listens on. Anything but loopback needs a token;
# leave MCAST_TOKEN empty to have one generated (it's printed at the end and
# kept in /etc/mcast/mcast.env).
MCAST_LISTEN="0.0.0.0:8650"
MCAST_TOKEN=""
# Interface for jobs, discovery and monitoring: "any", an IPv4 address or an
# interface index (see "mcast serve --help").
MCAST_IFACE="any"
# Extra arguments for "mcast serve", e.g. "--watch 239.192.2.1:10000".
MCAST_EXTRA_ARGS=""
# A token that only lets probes check in, so the one copied onto every probe
# can't be used to page. Leave empty to have one generated (printed at the end).
MCAST_PROBE_TOKEN=""

# --- Probe -----------------------------------------------------------------
# Run "mcast probe": watch the multicast streams here and report to an mcast
# server (see docs/probes.md). For a probe-only Pi set MCAST_SERVE=no too.
ENABLE_PROBE=no
# The server, e.g. "http://10.0.0.5:8650". Empty: find it by its multicast
# beacon (it must know PROBE_TOKEN).
PROBE_SERVER=""
# The server's probe token (MCAST_PROBE_TOKEN on the server). Required.
PROBE_TOKEN=""
# This probe's name on the server (empty: the hostname).
PROBE_ID=""
# When finding the server by beacon, only one whose hostname contains this.
PROBE_SERVER_NAME=""
# UDP port for the server's unicast copies (the firewall opens it).
PROBE_UNICAST_PORT=5104
# Extra arguments for "mcast probe run", e.g. "--verbose".
PROBE_EXTRA_ARGS=""

# --- LLDP ------------------------------------------------------------------
# Announce this Pi to the switch (and see which switch port it's on).
ENABLE_LLDP=yes
# Also speak CDP, for Cisco gear that doesn't do LLDP (only sent when a CDP
# neighbor is seen).
LLDP_CDP=yes
# Interfaces to announce on (lldpd pattern).
LLDP_INTERFACES="eth*,end*,wlan*"
LLDP_DESCRIPTION="mcast paging/monitoring appliance (Raspberry Pi)"

# --- SSH -------------------------------------------------------------------
# Turn off password logins. Only applied when ADMIN_USER has an
# authorized_keys file, so you can't lock yourself out.
SSH_KEYS_ONLY=yes

# --- Remote access ---------------------------------------------------------
# Cockpit: web admin with a terminal, logs, services and updates on :9090.
ENABLE_COCKPIT=yes
# Tailscale: reach the Pi from anywhere without port forwarding. You still
# need to run "sudo tailscale up --ssh" once to log it in.
ENABLE_TAILSCALE=no

# --- Network and system ----------------------------------------------------
# nftables firewall that allows only what this build uses.
ENABLE_FIREWALL=yes
# Advertise the web GUI and SSH over mDNS (http://<hostname>.local:8650/).
ENABLE_AVAHI=yes
# Multicast tuning: more IGMP memberships, bigger socket buffers, loose
# reverse-path filtering.
ENABLE_SYSCTL=yes
# Hardware watchdog: reboot if the system hangs.
ENABLE_WATCHDOG=yes
# Install security updates automatically.
ENABLE_UNATTENDED_UPGRADES=yes
# Keep the journal in RAM only (saves SD card wear, loses logs on reboot).
JOURNAL_VOLATILE=no
# Network troubleshooting tools: tcpdump, tshark, iperf3, ethtool, mtr, ...
INSTALL_NET_TOOLS=yes
# Show IP, LLDP neighbor (switch/port/VLAN) and mcast status at SSH login.
ENABLE_MOTD=yes
