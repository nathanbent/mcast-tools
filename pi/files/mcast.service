# Installed by mcast-tools/pi/install.sh as /etc/systemd/system/mcast.service.
[Unit]
Description=mcast web GUI and API (mcast serve)
Documentation=https://github.com/nathanbent/mcast-tools
Wants=network-online.target
After=network-online.target sound.target

[Service]
Type=simple
User=mcast
Group=mcast
# Live input and the Listen button need the sound card.
SupplementaryGroups=audio
EnvironmentFile=/etc/mcast/mcast.env
Environment=HOME=/var/lib/mcast
ExecStart=/usr/local/bin/mcast serve --listen ${MCAST_LISTEN} --iface ${MCAST_IFACE} --media-dir /var/lib/mcast/media $MCAST_EXTRA_ARGS
Restart=on-failure
RestartSec=3
# Paging is latency-sensitive; stay ahead of background work.
Nice=-10
LimitRTPRIO=50

StateDirectory=mcast
WorkingDirectory=/var/lib/mcast
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
