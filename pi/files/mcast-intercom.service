# Installed by mcast-tools/pi/install.sh as /etc/systemd/system/mcast-intercom.service.
[Unit]
Description=mcast intercom panel and schedules (mcast intercom serve)
Documentation=https://github.com/nathanbent/mcast-tools/tree/main/crates/mcast-intercom
# It plays through mcast serve on this Pi, and copes while that restarts.
Wants=mcast.service network-online.target
After=mcast.service network-online.target time-sync.target

[Service]
Type=simple
User=mcast
Group=mcast
# MCAST_TOKEN (to reach mcast serve) comes from mcast.env; the panel's own
# settings, token and the URL of mcast serve from intercom.env.
EnvironmentFile=/etc/mcast/mcast.env
EnvironmentFile=/etc/mcast/intercom.env
Environment=HOME=/var/lib/mcast
ExecStart=/usr/local/bin/mcast intercom serve --listen ${MCAST_INTERCOM_LISTEN}
Restart=on-failure
RestartSec=3

# Shares mcast's state directory: intercom.json lives in /var/lib/mcast.
StateDirectory=mcast
WorkingDirectory=/var/lib/mcast
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
